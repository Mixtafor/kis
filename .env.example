# Пример настроек для локального запска
COMPOSE_PROJECT_NAME=edition
POSTGRES_USER=edition
POSTGRES_PASSWORD=edition-local-password
POSTGRES_DB=edition
DB_PORT=5433
HTTP_PORT=8080
DATABASE_URL=postgres://edition:edition-local-password@127.0.0.1:5433/edition?sslmode=disable
HTTP_ADDR=:8080
EDITOR_API_KEY=local-editor-key-change-me-2026
JWT_SECRET=local-jwt-signing-secret-change-me-2026
SESSION_TTL=24h
LOG_LEVEL=info
DEMO_API_KEY=demo-only-shared-api-key-2026
EDITION_URL=http://127.0.0.1:8080
